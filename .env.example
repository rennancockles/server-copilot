# Copy to .env and adjust. Compose reads it automatically. Never commit .env.

# Required: bearer token for the /mcp endpoint (minimum 32 characters).
# Generate one with: openssl rand -hex 32
SERVER_COPILOT_AUTH_TOKEN=

# Optional OAuth sign-in for /mcp (ChatGPT), through WorkOS AuthKit. Set both or neither, both
# https://. The WorkOS Resource Indicator to register is <PUBLIC_URL>/mcp. The bearer token above
# keeps working. See "OAuth sign-in" in the README.
SERVER_COPILOT_PUBLIC_URL=
SERVER_COPILOT_AUTHKIT_DOMAIN=
# Verified emails allowed to sign in, comma separated. Empty allows nobody.
SERVER_COPILOT_OAUTH_ALLOWED_EMAILS=

# Local development only: true turns authentication OFF for every tool.
# Keep false on the server (compose loads this file into the container).
SERVER_COPILOT_AUTH_DISABLED=false

# Interface the MCP server binds to. Keep 0.0.0.0 in the container so cloudflared can reach it.
SERVER_COPILOT_HOST=0.0.0.0

# Port the MCP server listens on inside the container
# (point cloudflared to http://server-copilot:<port>)
SERVER_COPILOT_PORT=8000

# Docker API endpoint exposed by docker-socket-proxy on docker-api
SERVER_COPILOT_DOCKER_HOST=tcp://docker-socket-proxy:2375

# Host disks to report in get_host_metrics: name=/container/path, comma separated.
# Each path needs a read-only bind mount under `volumes` in docker-compose.yml.
# Leave empty to skip disk metrics.
SERVER_COPILOT_HOST_DISKS=root=/host/root,data=/host/data
