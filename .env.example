# Copy to .env and adjust. Compose reads it automatically.

# Port the MCP server listens on inside the container (point cloudflared to http://server-copilot:<port>)
SERVER_COPILOT_PORT=8000

# Docker API endpoint exposed by docker-socket-proxy on server-copilot-net
SERVER_COPILOT_DOCKER_HOST=tcp://docker-socket-proxy:2375
